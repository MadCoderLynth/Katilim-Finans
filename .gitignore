__pycache__/
*.pyc
.venv/
venv/

# Ham KAP HTML'leri ve üretilen paneller sürüm kontrolüne girmez.
# Ham arşiv yerelde saklanır (Spec §3.2: ham HTML her zaman saklanır).
#
# DİKKAT: bu dizinler bir önbellek değil, telafisi olmayan arşivdir —
# KAP sorgu penceresi 1 yıl ve kayıyor (ROTA_KESFI_RAPORU.md §5).
# Git'e girmiyorlar diye silinebilir sayılmazlar; ayrı yedeklenmeleri gerekir.
veri/ham/*
veri/panel/*
veri/onbellek/*
veri/referans/*
!veri/*/.gitkeep

# İSTİSNA — veri/evren/ git'e GİRER (1.4a kararı).
# 1.4a ölçtü: pencere keşfi öldürüyor, erişimi değil (15/15 indi, 404 yok).
# Yani 239 MB'lık HTML, ~90 KB'lık kimlik listesinden yeniden kurulabilir;
# telafisi olmayan tek parça bu. Ek fayda: her commit o günün keşif
# penceresinin fotoğrafını tutuyor — pencerenin nasıl kaydığının kaydı
# kendiliğinden birikiyor.
veri/evren/arsiv/*
!veri/evren/*.csv

.claude/settings.local.json
COMMIT_MESAJI.txt

.DS_Store
.idea/
.vscode/
